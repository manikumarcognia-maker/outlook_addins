# FastAPI server
PORT=4000

# Public HTTPS origin of this app (Replit / production). Used to rewrite Outlook manifest URLs.
# Example: https://your-repl-name.replit.app
# ADDIN_PUBLIC_URL=

# RAG indexing — required
GOOGLE_API_KEY=           # Gemini API key for dense embeddings
QDRANT_URL=               # e.g. http://localhost:6333 or Qdrant Cloud URL
QDRANT_API_KEY=           # Required for Qdrant Cloud; omit for local Docker
QDRANT_COLLECTION=fr8labs_production
QDRANT_DENSE_VECTOR_NAME=dense
QDRANT_SPARSE_VECTOR_NAME=sparse

# RAG indexing — optional
RAW_DOCUMENT_DIR=./document_store/raw
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
DENSE_EMBEDDING_DIM=3072
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_BATCH_SIZE=5
EMBEDDING_BATCH_DELAY_SEC=2.0
EMBEDDING_MAX_RETRIES=5

# RAG retrieval + generation — required
COHERE_API_KEY=           # Cohere API key for reranking
GENERATION_MODEL=gemini-3.5-flash-lite
COHERE_RERANK_MODEL=rerank-english-v3.0
RETRIEVAL_TOP_K=30
RERANK_TOP_N=5
EMAIL_MAX_CHARS=8000
GENERATION_MAX_OUTPUT_TOKENS=768
MAX_UPLOAD_BYTES=20971520

# Logging + OpenTelemetry spans (written to log file)
LOG_FILE=./logs/fr8labs.log
LOG_LEVEL=INFO

# Future API integrations
# GROQ_API_KEY=
# FR8LABS_API_BASE=
