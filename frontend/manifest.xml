<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <Id>ace6ee27-d0ce-4026-875f-027b020a1dac</Id>
  <Version>1.0.0.1</Version>
  <ProviderName>Ziffity</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Fr8Labs Assistant" />
  <Description DefaultValue="AI draft reply, create quote, and verify customer from Outlook." />
  <IconUrl DefaultValue="https://outlook-addins.manikumar-cognia.workers.dev/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://outlook-addins.manikumar-cognia.workers.dev/assets/icon-80.png" />
  <SupportUrl DefaultValue="https://outlook-addins.manikumar-cognia.workers.dev/support.html" />

  <AppDomains>
    <AppDomain>https://outlook-addins.manikumar-cognia.workers.dev</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.5" />
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://outlook-addins.manikumar-cognia.workers.dev/index.html" />
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.5">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>

    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url" />

          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="fr8labsGroup">
                <Label resid="GroupLabel" />

                <!-- Single toolbar button (like v1) — tabs inside task pane for Quote/Customer -->
                <Control xsi:type="Button" id="fr8labsOpenBtn">
                  <Label resid="Open.Label" />
                  <Supertip>
                    <Title resid="Open.Label" />
                    <Description resid="Open.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>

              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://outlook-addins.manikumar-cognia.workers.dev/assets/icon-16.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://outlook-addins.manikumar-cognia.workers.dev/assets/icon-32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://outlook-addins.manikumar-cognia.workers.dev/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://outlook-addins.manikumar-cognia.workers.dev/commands.html" />
        <bt:Url id="Taskpane.Url" DefaultValue="https://outlook-addins.manikumar-cognia.workers.dev/index.html?view=draft" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Fr8Labs" />
        <bt:String id="Open.Label" DefaultValue="Fr8Labs Assistant" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Open.Tooltip" DefaultValue="Open Fr8Labs Assistant - draft reply, create quote, or verify customer." />
      </bt:LongStrings>
    </Resources>

    <!-- v1.1 enables pinnable task pane (pin icon keeps pane open across emails) -->
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.5">
          <bt:Set Name="Mailbox" />
        </bt:Sets>
      </Requirements>

      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <FunctionFile resid="Commands.Url" />
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="fr8labsGroup">
                  <Label resid="GroupLabel" />

                  <Control xsi:type="Button" id="fr8labsOpenBtn">
                    <Label resid="Open.Label" />
                    <Supertip>
                      <Title resid="Open.Label" />
                      <Description resid="Open.Tooltip" />
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16" />
                      <bt:Image size="32" resid="Icon.32x32" />
                      <bt:Image size="80" resid="Icon.80x80" />
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url" />
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>

                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>

      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16x16" DefaultValue="https://outlook-addins.manikumar-cognia.workers.dev/assets/icon-16.png" />
          <bt:Image id="Icon.32x32" DefaultValue="https://outlook-addins.manikumar-cognia.workers.dev/assets/icon-32.png" />
          <bt:Image id="Icon.80x80" DefaultValue="https://outlook-addins.manikumar-cognia.workers.dev/assets/icon-80.png" />
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Commands.Url" DefaultValue="https://outlook-addins.manikumar-cognia.workers.dev/commands.html" />
          <bt:Url id="Taskpane.Url" DefaultValue="https://outlook-addins.manikumar-cognia.workers.dev/index.html?view=draft" />
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="Fr8Labs" />
          <bt:String id="Open.Label" DefaultValue="Fr8Labs Assistant" />
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="Open.Tooltip" DefaultValue="Open Fr8Labs Assistant - draft reply, create quote, or verify customer." />
        </bt:LongStrings>
      </Resources>

      <!-- Entra app Outlook-assistant: client ID only (never put client secrets in the manifest). -->
      <WebApplicationInfo>
        <Id>0d27c3be-594a-4c12-96d4-f17b1b704b7e</Id>
        <Resource>api://outlook-addins.manikumar-cognia.workers.dev/0d27c3be-594a-4c12-96d4-f17b1b704b7e</Resource>
        <Scopes>
          <Scope>openid</Scope>
          <Scope>profile</Scope>
          <Scope>access_as_user</Scope>
        </Scopes>
      </WebApplicationInfo>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
